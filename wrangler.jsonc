{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "one8-bis",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",

  // public/index.html is served for "/"; anything that is not a file
  // (e.g. /api/notify, /api/health) falls through to src/index.js.
  "assets": {
    "directory": "./public"
  },

  "workers_dev": true,
  // No per-version preview URLs: the API should only answer on one hostname.
  "preview_urls": false,

  // Keeps console.error output (including the Shopify scope/approval hints)
  // searchable under the Worker's Logs tab.
  "observability": {
    "enabled": true
  },

  // One codebase, one Worker per store. Store settings are NOT in this file:
  // each Worker gets them in the dashboard (Settings > Variables and Secrets):
  //   SHOPIFY_STORE_DOMAIN  text    e.g. 6qx7kf-as.myshopify.com
  //   ALLOWED_ORIGINS       text    e.g. https://one8.com,https://www.one8.com
  //   SHOPIFY_ADMIN_TOKEN   secret
  // keep_vars stops each deploy from wiping the dashboard text vars.
  "keep_vars": true,

  // Per-IP limits, counted per Cloudflare location. namespace_id only has to
  // be unique within the Cloudflare account; period must be 10 or 60.
  // Rate limits are not inherited by environments, so each store below
  // repeats them with its own namespace_ids.
  "ratelimits": [
    {
      "name": "NOTIFY_WRITE_LIMITER",
      "namespace_id": "1801",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "NOTIFY_READ_LIMITER",
      "namespace_id": "1802",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // The top level above is the one8 India Worker (one8-bis, deploy command
  // `npx wrangler deploy`). Each extra store is an environment whose name
  // matches its Worker in the dashboard, deployed with
  // `npx wrangler deploy --env <key>`.
  "env": {
    "global": {
      "name": "one8-global",
      "ratelimits": [
        {
          "name": "NOTIFY_WRITE_LIMITER",
          "namespace_id": "1803",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "NOTIFY_READ_LIMITER",
          "namespace_id": "1804",
          "simple": { "limit": 30, "period": 60 }
        }
      ]
    }
  }
}
